# How compiled languages (C, C++, Java, Kotlin, C#, Go, Rust, Scala, Dart,
# Ruby, PHP, Swift) are run. Python, R, SQL, HTML, JS and TS always run in
# the browser and need none of this.

# Default — nothing to set: the free online services Wandbox (wandbox.org)
# and Compiler Explorer (godbolt.org, for Kotlin and Dart) compile and run the
# code. The code is sent to them. If /api/run is missing (a static host) or
# can't reach them, the browser calls them directly.
# RUNNER_BACKEND=online
# To switch compiled languages off: RUNNER_BACKEND=none

# Option 1 — self-hosted Piston: sandboxed, open source, private.
# RUNNER_BACKEND=piston
# PISTON_URL=http://localhost:2000

# Option 2 — Judge0 (self-hosted CE, or the RapidAPI plan with a key).
# RUNNER_BACKEND=judge0
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=your-rapidapi-key

# Option 3 — local toolchains, DEVELOPMENT ONLY (no sandbox). Refused in
# production unless you also set ALLOW_UNSAFE_LOCAL_RUNNER=1.
# RUNNER_BACKEND=local
